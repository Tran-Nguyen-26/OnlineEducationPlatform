# Serves the SPA and reverse-proxies the API, so the browser sees ONE origin (no CORS, one TLS certificate).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 2m;          # file uploads go straight to object storage, never through here
    server_tokens off;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # img/media/connect must include the object-storage origin (presigned URLs); fonts/styles come from Google Fonts.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: ${STORAGE_PUBLIC_ORIGIN} https:; media-src 'self' blob: ${STORAGE_PUBLIC_ORIGIN} https:; connect-src 'self' ${STORAGE_PUBLIC_ORIGIN}; frame-src ${STORAGE_PUBLIC_ORIGIN} https://www.youtube.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    location = /healthz { access_log off; return 200 "ok\n"; add_header Content-Type text/plain; }

    # nginx resolves a hostname in proxy_pass only once at start-up. Using a variable plus a resolver makes it re-resolve
    # every few seconds, so a recreated gateway (new container / ECS task IP) is picked up without restarting nginx.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $gateway ${GATEWAY_URL};

    location /api/ {
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # fingerprinted build assets can be cached for a year; index.html must always be revalidated
    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        # add_header is not inherited once a location defines its own, so the security headers are repeated here
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: ${STORAGE_PUBLIC_ORIGIN} https:; media-src 'self' blob: ${STORAGE_PUBLIC_ORIGIN} https:; connect-src 'self' ${STORAGE_PUBLIC_ORIGIN}; frame-src ${STORAGE_PUBLIC_ORIGIN} https://www.youtube.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    }
}
