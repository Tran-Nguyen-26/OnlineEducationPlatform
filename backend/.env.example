# Variables read by the services (profile "prod" has NO defaults for secrets — generate real values).
# Database
DB_URL=jdbc:postgresql://<primary-host>:5432/oep
DB_USER=
DB_PASSWORD=
DB_REPLICA_URL=jdbc:postgresql://<replica-host>:5432/oep
DB_REPLICA_USER=
DB_REPLICA_PASSWORD=
# Messaging / cache
RABBIT_HOST=
RABBIT_PORT=5672
RABBIT_USER=
RABBIT_PASSWORD=
REDIS_HOST=
REDIS_PASSWORD=
# Object storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=oep-content
# JWT signing key: PKCS#8 PEM mounted from a secret store. Generate:  openssl genrsa -out jwt-private.pem 2048 && openssl pkcs8 -topk8 -nocrypt -in jwt-private.pem -out jwt-private-pkcs8.pem
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt-private-pkcs8.pem
# Rotation: keep the previous PUBLIC key(s) here (comma-separated paths) until their tokens (15 min) have expired
JWT_PREVIOUS_PUBLIC_KEY_FILES=
JWK_SET_URI=http://core-lms-service:8081/.well-known/jwks.json
# First admin account
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# Gateway
CORS_ALLOWED_ORIGINS=https://app.example.com
